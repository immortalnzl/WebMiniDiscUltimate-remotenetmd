# --- Option 1: Local folder (bind mount) ---
MUSIC_PATH=/path/to/your/music
VOLUME_TYPE=none
VOLUME_OPTIONS=bind

# --- Option 2: NFS share ---
# MUSIC_PATH=/mnt/nfs/music
# VOLUME_TYPE=nfs
# VOLUME_OPTIONS=addr=10.1.4.10,nolock,soft

# --- Option 3: SMB / CIFS network share ---
# MUSIC_PATH=//10.1.4.10/Music
# VOLUME_TYPE=cifs
# VOLUME_OPTIONS=username=YOUR_USER,password=YOUR_PASS,vers=3.0,ro

DOTENV_PATH=/app/.env

# Optional: override bundled self-hosted ATRAC API image
# ATRAC_API_IMAGE=seedstohr/atrac-api:latest
# ATRAC_API_PLATFORM=linux/amd64
